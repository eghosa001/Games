[application]
config/name="RENEW"
config/icon="res://Assets/renew_icon.svg"
run/main_scene="res://scenes/Main.tscn"

[autoload]
RenewAutosave="*res://scripts/autosave.gd"
RenewGameState="*res://scripts/game_state.gd"
RenewEmployeeSystem="*res://scripts/employee_system.gd"
RenewHistorySystem="*res://scripts/history_system.gd"
RenewNewsSystem="*res://scripts/news_system.gd"
RenewFinanceSystem="*res://scripts/finance_system.gd"
RenewProductionSystem="*res://scripts/production_system.gd"
RenewSimulationSystem="*res://scripts/simulation_system.gd"
RenewContractSystem="*res://scripts/contract_system.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]
gdscript/warnings/enable=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
action_restore={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
action_inspect={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}
