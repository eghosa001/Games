[application]

config/name="Restora"
config/icon="res://Assets/restora_icon.svg"
boot_splash/show_image=true
boot_splash/image="res://Assets/restora_icon.svg"
boot_splash/fullsize=false
boot_splash/bg_color=Color(0.0431373, 0.0509804, 0.0627451, 1)
run/main_scene="res://scenes/Main.tscn"

[autoload]
RestoraThemeManager="*res://scripts/theme_manager.gd"
RenewWebResponsive="*res://scripts/web_responsive.gd"
RenewGameState="*res://scripts/game_state.gd"
RenewFinanceSystem="*res://scripts/finance_system_fixed.gd"
RenewSimulationSystem="*res://scripts/simulation_system.gd"
RenewProductionSystem="*res://scripts/production_system.gd"
RenewContractSystem="*res://scripts/contract_system.gd"
RenewAllianceSystem="*res://scripts/alliance_v1_system.gd"
RenewVictorySystem="*res://scripts/victory_system.gd"
RenewAudioManager="*res://scripts/audio_manager.gd"
RenewServices="*res://scripts/renew_services.gd"
RenewManagementPolicySystem="*res://scripts/management_policy_system.gd"
RenewManagementPolicyUI="*res://scripts/management_policy_ui.gd"
RenewRealTimeEconomySystem="*res://scripts/real_time_economy_system.gd"
RenewMonetizationSystem="*res://scripts/monetization_system.gd"
RenewUIScreenManager="*res://scripts/ui_screen_manager.gd"
RenewVisualStyleGuard="*res://scripts/visual_style_guard.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom="res://Assets/Themes/EmpireTheme.tres"

[debug]
gdscript/warnings/enable=true
gdscript/warnings/inference_on_variant=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.06, 1)

[input]
action_restore={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
action_inspect={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}
