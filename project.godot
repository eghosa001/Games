[application]
config/name="RENEW"
config/icon="res://Assets/renew_icon.svg"
run/main_scene="res://scenes/Main.tscn"

[autoload]
RenewAutosave="*res://scripts/autosave.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[debug]
gdscript/warnings/enable=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
action_restore={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
action_inspect={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}
